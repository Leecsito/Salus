# ── Groq API Keys ────────────────────────────────────────────────────────────
# Agrega todas las keys que tengas, separadas por coma (sin espacios)
GROQ_API_KEYS=gsk_tu_primera_key,gsk_tu_segunda_key

# ── Turso (base de datos) ─────────────────────────────────────────────────────
TURSO_URL=https://tu-db.turso.io
TURSO_TOKEN=tu_token_de_turso

# ── Groq (opcional) ───────────────────────────────────────────────────────────
# Modelo a usar; si se omite se usa openai/gpt-oss-20b
# GROQ_MODEL=openai/gpt-oss-20b
# Turnos recientes de contexto para extractor y vendedor; si se omite, 4
# HISTORIAL_TURNOS=4
# Máximo de productos por búsqueda; si se omite, 5
# LIMITE_PRODUCTOS=5

# ── Flask ─────────────────────────────────────────────────────────────────────
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-algo-seguro

# ── Logs (opcional) ───────────────────────────────────────────────────────────
# Nivel mínimo de logging: DEBUG, INFO, WARNING, ERROR (default INFO)
# LOG_LEVEL=INFO
# Entradas conservadas en memoria para el panel de logs (default 500)
# LOGS_BUFFER=500
