# ── Groq API Keys ────────────────────────────────────────────────────────────
# Agrega todas las keys que tengas, separadas por coma (sin espacios)
GROQ_API_KEYS=gsk_tu_primera_key,gsk_tu_segunda_key

# ── Turso (base de datos) ─────────────────────────────────────────────────────
TURSO_URL=https://tu-db.turso.io
TURSO_TOKEN=tu_token_de_turso

# ── Groq (opcional) ───────────────────────────────────────────────────────────
# Modelo a usar; si se omite se usa openai/gpt-oss-20b
# GROQ_MODEL=openai/gpt-oss-20b

# ── Flask ─────────────────────────────────────────────────────────────────────
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-algo-seguro
