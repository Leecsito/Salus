# ── Groq API Keys ────────────────────────────────────────────────────────────
# Agrega todas las keys que tengas, separadas por coma (sin espacios)
GROQ_API_KEYS=gsk_tu_primera_key,gsk_tu_segunda_key

# ── Turso (base de datos) ─────────────────────────────────────────────────────
TURSO_URL=https://tu-db.turso.io
TURSO_TOKEN=tu_token_de_turso

# ── Tavily (búsqueda web, opcional) ──────────────────────────────────────────
# Respaldo cuando la DB no alcanza (dato puntual o 0 resultados). Sin key, se omite.
TAVILY_API_KEY=tvly_tu_api_key

# ── Groq (opcional) ───────────────────────────────────────────────────────────
# Modelo a usar; si se omite se usa openai/gpt-oss-20b
# GROQ_MODEL=openai/gpt-oss-20b
# Modelo del extractor de productos (reparte la cuota diaria de tokens);
# si se omite se usa openai/gpt-oss-120b
# GROQ_MODEL_EXTRACCION=openai/gpt-oss-120b
# Turnos recientes de contexto para extractor y vendedor; si se omite, 4
# HISTORIAL_TURNOS=4
# Máximo de productos por búsqueda; si se omite, 6
# LIMITE_PRODUCTOS=6
# Búsqueda web (opcional): resultados por consulta, TTL de caché en segundos
# y máximo de consultas guardadas en memoria
# WEB_MAX_RESULTADOS=4
# WEB_CACHE_TTL=21600
# WEB_CACHE_MAX=200

# ── Flask ─────────────────────────────────────────────────────────────────────
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-algo-seguro

# ── Logs (opcional) ───────────────────────────────────────────────────────────
# Nivel mínimo de logging: DEBUG, INFO, WARNING, ERROR (default INFO)
# LOG_LEVEL=INFO
# Entradas conservadas en memoria para el panel de logs (default 500)
# LOGS_BUFFER=500
